        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Relasi Penjualan\n    petugas ||--o{ penjualan : \&quot;mencatat\&quot;\n    anggota |o--o{ penjualan : \&quot;melakukan\&quot;\n    penjualan ||--|{ detail_penjualan : \&quot;terdiri_dari\&quot;\n    barang ||--o{ detail_penjualan : \&quot;terjual_pada\&quot;\n\n    %% Relasi Pembelian (Pengadaan Stok)\n    pemasok ||--o{ pembelian : \&quot;menyuplai\&quot;\n    pembelian ||--|{ detail_pembelian : \&quot;terdiri_dari\&quot;\n    barang ||--o{ detail_pembelian : \&quot;dibeli_pada\&quot;\n\n    petugas {\n        SMALLINT id_petugas PK \&quot;AI\&quot;\n        CHAR(3) kode_petugas \&quot;UNIQUE\&quot;\n        VARCHAR(100) nama_petugas \&quot;NOT NULL\&quot;\n        ENUM peran_petugas \&quot;kasir/gudang/ketua\&quot;\n    }\n\n    anggota {\n        INT id_anggota PK \&quot;AI\&quot;\n        CHAR(6) no_anggota \&quot;UNIQUE\&quot;\n        CHAR(10) nim_anggota \&quot;UNIQUE\&quot;\n        VARCHAR(100) nama_anggota \&quot;NOT NULL\&quot;\n        VARCHAR(60) prodi_anggota \&quot;NOT NULL\&quot;\n        VARCHAR(15) no_hp_anggota \&quot;pribadi\&quot;\n        ENUM status_anggota \&quot;aktif/nonaktif\&quot;\n        DATE tgl_daftar_anggota \&quot;NOT NULL\&quot;\n    }\n\n    penjualan {\n        INT id_penjualan PK \&quot;AI\&quot;\n        CHAR(12) no_nota_penjualan \&quot;UNIQUE\&quot;\n        DATETIME tgl_penjualan \&quot;NOT NULL\&quot;\n        SMALLINT id_petugas FK \&quot;NOT NULL, -&gt; petugas\&quot;\n        INT id_anggota FK \&quot;NULL, -&gt; anggota\&quot;\n        DECIMAL(12_2) bayar_penjualan \&quot;NOT NULL\&quot;\n    }\n\n    detail_penjualan {\n        INT id_penjualan PK,FK \&quot;-&gt; penjualan\&quot;\n        INT id_barang PK,FK \&quot;-&gt; barang\&quot;\n        SMALLINT qty_detail_penjualan \&quot;CHECK &gt; 0\&quot;\n        DECIMAL(12_2) harga_satuan_detail_penjualan \&quot;NOT NULL\&quot;\n    }\n\n    barang {\n        INT id_barang PK \&quot;AI\&quot;\n        VARCHAR(10) kode_barang \&quot;UNIQUE\&quot;\n        VARCHAR(100) nama_barang \&quot;NOT NULL\&quot;\n        ENUM kategori_barang \&quot;ATK/makanan/minuman\&quot;\n        DECIMAL(12_2) harga_jual_barang \&quot;CHECK &gt;= 0\&quot;\n        INT stok_barang \&quot;CHECK &gt;= 0\&quot;\n        INT stok_min_barang \&quot;DEF 5\&quot;\n    }\n\n    pemasok {\n        INT id_pemasok PK \&quot;AI\&quot;\n        VARCHAR(100) nama_pemasok \&quot;NOT NULL\&quot;\n        VARCHAR(15) telepon_pemasok \&quot;NULL\&quot;\n        VARCHAR(200) alamat_pemasok \&quot;NULL\&quot;\n    }\n\n    pembelian {\n        INT id_pembelian PK \&quot;AI\&quot;\n        VARCHAR(20) no_faktur_pembelian \&quot;NOT NULL\&quot;\n        DATE tgl_pembelian \&quot;NOT NULL\&quot;\n        INT id_pemasok FK \&quot;NOT NULL, -&gt; pemasok\&quot;\n        ENUM status_pembelian \&quot;dipesan/diterima\&quot;\n    }\n\n    detail_pembelian {\n        INT id_pembelian PK,FK \&quot;-&gt; pembelian\&quot;\n        INT id_barang PK,FK \&quot;-&gt; barang\&quot;\n        INT qty_detail_pembelian \&quot;CHECK &gt; 0\&quot;\n        DECIMAL(12_2) harga_beli_detail_pembelian \&quot;NOT NULL\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="T0J2uiUseVXuRteKx7ox-1">
