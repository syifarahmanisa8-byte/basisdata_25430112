        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Relasi Kategori dan Buku\n    kategori ||--|{ buku : \&quot;memiliki\&quot;\n\n    %% Relasi Transaksi Peminjaman\n    pustakawan ||--o{ peminjaman : \&quot;melayani\&quot;\n    anggota ||--o{ peminjaman : \&quot;melakukan\&quot;\n    peminjaman ||--|{ detail_pinjam : \&quot;terdiri_dari\&quot;\n    buku ||--o{ detail_pinjam : \&quot;dipinjam_pada\&quot;\n\n    kategori {\n        SMALLINT id_kategori PK \&quot;AI\&quot;\n        VARCHAR nama_kategori \&quot;NOT_NULL\&quot;\n    }\n\n    buku {\n        INT id_buku PK \&quot;AI\&quot;\n        CHAR kode_buku \&quot;UNIQUE\&quot;\n        VARCHAR judul_buku \&quot;NOT_NULL\&quot;\n        VARCHAR pengarang_buku \&quot;NOT_NULL\&quot;\n        VARCHAR penerbit_buku \&quot;NOT_NULL\&quot;\n        YEAR tahun_terbit \&quot;NOT_NULL\&quot;\n        INT stok_buku \&quot;CHECK_&gt;=_0\&quot;\n        SMALLINT id_kategori FK \&quot;kategori\&quot;\n    }\n\n    pustakawan {\n        SMALLINT id_pustakawan PK \&quot;AI\&quot;\n        VARCHAR nama_pustakawan \&quot;NOT_NULL\&quot;\n    }\n\n    anggota {\n        INT id_anggota PK \&quot;AI\&quot;\n        CHAR nim_anggota \&quot;UNIQUE\&quot;\n        VARCHAR nama_anggota \&quot;NOT_NULL\&quot;\n        VARCHAR prodi_anggota \&quot;NOT_NULL\&quot;\n        VARCHAR no_hp_anggota \&quot;pribadi\&quot;\n        VARCHAR alamat_anggota \&quot;pribadi\&quot;\n        ENUM status_anggota \&quot;aktif/nonaktif\&quot;\n    }\n\n    peminjaman {\n        INT id_peminjaman PK \&quot;AI\&quot;\n        CHAR no_peminjaman \&quot;UNIQUE\&quot;\n        DATE tgl_pinjam \&quot;NOT_NULL\&quot;\n        DATE tgl_jatuh_tempo \&quot;NOT_NULL\&quot;\n        ENUM status_pinjam \&quot;dipinjam/selesai\&quot;\n        SMALLINT id_pustakawan FK \&quot;pustakawan\&quot;\n        INT id_anggota FK \&quot;anggota\&quot;\n    }\n\n    detail_pinjam {\n        INT id_peminjaman PK,FK \&quot;peminjaman\&quot;\n        INT id_buku PK,FK \&quot;buku\&quot;\n        DATE tgl_kembali \&quot;NULL\&quot;\n        DECIMAL nominal_denda \&quot;CHECK_&gt;=_0\&quot;\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="I1ciy5XecMb2KewQh1yI-1">
